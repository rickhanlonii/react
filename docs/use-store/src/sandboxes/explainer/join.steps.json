{
  "steps": [
    {"expectText": ".First", "equals": "First: old"},
    {"click": "button.transition"},
    {"expectStepper": {"pending": true}},
    {"expectText": ".First", "equals": "First: old"},
    {"click": "button.mount"},
    {"expectText": ".Second", "equals": "Second: old"},
    {"expectText": ".First", "equals": "First: old"},
    {"clearConsole": true},
