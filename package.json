{
  "name": "react-dom-native-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "React framework mapping HTML elements to native iOS views",
  "workspaces": [
    "packages/*",
    "example",
    "example/server",
    "tools/*"
  ],
  "scripts": {
    "build": "cd example && npm run build",
    "build:prod": "cd example && npm run build:prod",
    "dev": "cd example && npm run dev",
    "test": "jest --selectProjects unit server-actions --forceExit",
    "test:swift": "bash scripts/build-op.sh test-swift",
    "test:fantom": "bash scripts/build-fantom.sh --if-needed && jest --selectProjects fantom",
    "test:all": "jest",
    "build:fantom": "bash scripts/build-fantom.sh",
    "build:e2e": "node tests/e2e/scripts/build.js",
    "dev:e2e": "node tests/e2e/scripts/dev.js",
    "e2e:check": "node tests/e2e/scripts/check.js",
    "e2e:test": "node tests/e2e/scripts/test.js",
    "test:trace": "node example/scripts/test-trace.js",
    "perf": "node scripts/perf-profile.js",
    "build-server": "node scripts/build-server.js",
    "test:e2e-swift": "bash scripts/build-op.sh test-e2e-swift",
    "app:run": "bash scripts/build-op.sh run",
    "app:clean": "bash scripts/build-op.sh clean",
    "app:screenshot": "bash scripts/build-op.sh screenshot",
    "app:terminate": "bash scripts/build-op.sh terminate",
    "app:tap": "bash scripts/build-op.sh tap",
    "app:swipe": "bash scripts/build-op.sh swipe",
    "app:snapshot-ui": "bash scripts/build-op.sh snapshot-ui",
    "app:type-text": "bash scripts/build-op.sh type-text",
    "app:gesture": "bash scripts/build-op.sh gesture",
    "app:button": "bash scripts/build-op.sh button",
    "app:long-press": "bash scripts/build-op.sh long-press",
    "app:key-press": "bash scripts/build-op.sh key-press",
    "app:debug-attach": "bash scripts/build-op.sh debug-attach",
    "app:debug-detach": "bash scripts/build-op.sh debug-detach",
    "app:debug-lldb": "bash scripts/build-op.sh debug-lldb",
    "app:debug-stack": "bash scripts/build-op.sh debug-stack",
    "app:debug-variables": "bash scripts/build-op.sh debug-variables",
    "app:log-start": "bash scripts/build-op.sh log-start",
    "app:log-read": "bash scripts/build-op.sh log-read",
    "app:log-stop": "bash scripts/build-op.sh log-stop",
    "app:list": "bash scripts/build-op.sh list",
    "app:open": "bash scripts/build-op.sh open"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.7.0",
    "xcodebuildmcp": "^2.0.7"
  },
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.27.3",
    "react-refresh": "^0.18.0"
  }
}
