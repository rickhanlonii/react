{
  "name": "react-dom-native-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "React framework mapping HTML elements to native iOS views",
  "workspaces": [
    "packages/*",
    "example",
    "example/server",
    "tools/*"
  ],
  "scripts": {
    "build": "cd example && npm run build",
    "build:prod": "cd example && npm run build:prod",
    "dev": "cd example && npm run dev",
    "test": "jest --selectProjects unit",
    "test:swift": "bash scripts/test-swift.sh",
    "test:fantom": "bash scripts/build-fantom.sh --if-needed && jest --selectProjects fantom",
    "test:all": "jest",
    "build:fantom": "bash scripts/build-fantom.sh",
    "build:e2e": "node tests/e2e/scripts/build.js",
    "dev:e2e": "node tests/e2e/scripts/dev.js",
    "e2e:check": "node tests/e2e/scripts/check.js",
    "e2e:test": "node tests/e2e/scripts/test.js",
    "test:trace": "node example/scripts/test-trace.js",
    "build-server": "node scripts/build-server.js",
    "test:e2e-swift": "bash scripts/test-e2e-swift.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.27.3",
    "react-refresh": "^0.18.0"
  }
}
