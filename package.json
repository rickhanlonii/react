{
  "name": "react-dom-native",
  "version": "0.0.1",
  "private": true,
  "description": "React framework mapping HTML elements to native iOS views",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-js.js",
    "build:prod": "node scripts/build-js.js --production",
    "dev": "bash scripts/dev.sh",
    "dev:server": "cd server && node --conditions react-server server.js",
    "test": "jest --selectProjects unit",
    "test:fantom": "jest --selectProjects fantom",
    "test:all": "jest",
    "build:fantom": "bash scripts/build-fantom.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
